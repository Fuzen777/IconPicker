<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IconPicker.App.Controls.StatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <InfoBar
      IsOpen="{x:Bind Status.IsOpen, Mode=TwoWay}"
      Severity="{x:Bind Status.Severity, Mode=OneWay}"
      Title="{x:Bind Status.Title, Mode=OneWay}"
      Message="{x:Bind Status.Message, Mode=OneWay}">
    <InfoBar.ActionButton>
      <Button Content="{x:Bind Status.ActionText, Mode=OneWay}" Command="{x:Bind Status.ActionCommand, Mode=OneWay}" Visibility="{x:Bind Status.HasAction, Mode=OneWay}" />
    </InfoBar.ActionButton>
  </InfoBar>
</UserControl>
