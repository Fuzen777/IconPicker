<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IconPicker.App.Controls.IconBuilderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IconPicker.App.Controls">
  <UserControl.Resources>
    <!-- Fixed light and dark backdrops, so the preview shows how the icon reads on both. -->
    <SolidColorBrush x:Key="LightBackdropBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="DarkBackdropBrush" Color="#202020" />
  </UserControl.Resources>

  <Grid ColumnSpacing="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="300" />
    </Grid.ColumnDefinitions>

    <!-- Preview: 256 px, then 48, 32 and 16 px on light and dark backdrops. -->
    <StackPanel Spacing="12">
      <Border Width="208" Height="208" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
          <Image Width="192" Height="192" Source="{x:Bind ViewModel.LargePreview, Mode=OneWay}" Stretch="Uniform" />
          <TextBlock
              x:Uid="BuilderEmptyPreview"
              MaxWidth="160"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              TextAlignment="Center"
              TextWrapping="Wrap"
              Visibility="{x:Bind ViewModel.HasNoPreview, Mode=OneWay}" />
        </Grid>
      </Border>
      <Border Width="208" Padding="12" Background="{StaticResource LightBackdropBrush}" CornerRadius="8">
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="16">
          <Image Width="48" Height="48" VerticalAlignment="Center" Source="{x:Bind ViewModel.Preview48, Mode=OneWay}" />
          <Image Width="32" Height="32" VerticalAlignment="Center" Source="{x:Bind ViewModel.Preview32, Mode=OneWay}" />
          <Image Width="16" Height="16" VerticalAlignment="Center" Source="{x:Bind ViewModel.Preview16, Mode=OneWay}" />
        </StackPanel>
      </Border>
      <Border Width="208" Padding="12" Background="{StaticResource DarkBackdropBrush}" CornerRadius="8">
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="16">
          <Image Width="48" Height="48" VerticalAlignment="Center" Source="{x:Bind ViewModel.Preview48, Mode=OneWay}" />
          <Image Width="32" Height="32" VerticalAlignment="Center" Source="{x:Bind ViewModel.Preview32, Mode=OneWay}" />
          <Image Width="16" Height="16" VerticalAlignment="Center" Source="{x:Bind ViewModel.Preview16, Mode=OneWay}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Settings. -->
    <ScrollViewer Grid.Column="1" Visibility="{x:Bind ViewModel.IsSettingsPane, Mode=OneWay}">
      <StackPanel Padding="0,0,12,0" Spacing="12">
        <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}" Message="{x:Bind ViewModel.ProblemText, Mode=OneWay}" />

        <TextBlock x:Uid="BuilderIconTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Uid="BuilderBuiltInButton" Command="{x:Bind ViewModel.ShowBuiltInIconsCommand}" />
          <Button x:Uid="BuilderBrowseButton" Command="{x:Bind ViewModel.BrowseCommand}" />
        </StackPanel>
        <TextBlock
            x:Uid="BuilderSeveralColors"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasSeveralColors, Mode=OneWay}" />
        <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.CanRecolor, Mode=OneWay}">
          <ToggleSwitch x:Uid="BuilderRecolorToggle" MinWidth="0" IsOn="{x:Bind ViewModel.IsRecolored, Mode=TwoWay}" />
          <controls:ColorPickerButton
              x:Uid="BuilderIconColorButton"
              VerticalAlignment="Bottom"
              Color="{x:Bind ViewModel.IconColor, Mode=TwoWay}"
              PresetColors="{x:Bind ViewModel.PresetColors}"
              RecentColors="{x:Bind ViewModel.RecentColors, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.ShowsIconColor, Mode=OneWay}" />
        </StackPanel>

        <TextBlock x:Uid="BuilderBackgroundTitle" Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <RadioButtons x:Uid="BuilderShapeChoice" MaxColumns="5" SelectedIndex="{x:Bind ViewModel.ShapeIndex, Mode=TwoWay}">
          <RadioButton x:Uid="BuilderShapeNone" />
          <RadioButton x:Uid="BuilderShapeSquare" />
          <RadioButton x:Uid="BuilderShapeRounded" />
          <RadioButton x:Uid="BuilderShapeCircle" />
          <RadioButton x:Uid="BuilderShapeFolder" />
        </RadioButtons>
        <controls:ColorPickerButton
            x:Uid="BuilderBackgroundColorButton"
            HorizontalAlignment="Left"
            Color="{x:Bind ViewModel.BackgroundColor, Mode=TwoWay}"
            PresetColors="{x:Bind ViewModel.PresetColors}"
            RecentColors="{x:Bind ViewModel.RecentColors, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.UsesBackgroundColor, Mode=OneWay}" />

        <Slider
            x:Uid="BuilderSizeSlider"
            Margin="0,8,0,0"
            Maximum="100"
            Minimum="40"
            StepFrequency="1"
            Value="{x:Bind ViewModel.IconSizePercent, Mode=TwoWay}" />

        <TextBox x:Uid="BuilderNameBox" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </ScrollViewer>

    <!-- The built-in icons, in place of the settings. -->
    <Grid Grid.Column="1" RowSpacing="8" Visibility="{x:Bind ViewModel.IsBuiltInIconsPane, Mode=OneWay}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <HyperlinkButton x:Uid="BuilderBackButton" Command="{x:Bind ViewModel.BackToSettingsCommand}" />
      <controls:IconListControl Grid.Row="1" ViewModel="{x:Bind ViewModel.BuiltInList, Mode=OneWay}" />
    </Grid>

    <!-- The icons of a browsed .exe or .dll holding several. -->
    <Grid Grid.Column="1" RowSpacing="8" Visibility="{x:Bind ViewModel.IsModuleIconsPane, Mode=OneWay}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <HyperlinkButton x:Uid="BuilderBackButton" Command="{x:Bind ViewModel.BackToSettingsCommand}" />
      <TextBlock Grid.Row="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.ModuleName, Mode=OneWay}" />
      <GridView
          Grid.Row="2"
          IsItemClickEnabled="True"
          ItemClick="OnModuleIconClick"
          ItemTemplate="{StaticResource CandidateTileTemplate}"
          ItemsSource="{x:Bind ViewModel.ModuleIcons}"
          SelectionMode="None" />
    </Grid>
  </Grid>
</UserControl>
