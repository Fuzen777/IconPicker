<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IconPicker.App.Controls.ColorPickerButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A button showing its color; its flyout offers preset swatches, recent colors and Windows' color picker. -->
  <DropDownButton x:Name="ColorButton" AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Border Width="20" Height="20" Background="{x:Bind ColorBrush, Mode=OneWay}" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" />
      <TextBlock VerticalAlignment="Center" Text="{x:Bind Label, Mode=OneWay}" />
    </StackPanel>
    <DropDownButton.Flyout>
      <Flyout Placement="Bottom" Opening="OnFlyoutOpening">
        <StackPanel Width="320" Spacing="8">
          <TextBlock x:Uid="ColorPresetsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <GridView
              x:Name="PresetGrid"
              IsItemClickEnabled="True"
              ItemClick="OnSwatchClick"
              ItemTemplate="{StaticResource ColorSwatchTemplate}"
              ItemsSource="{x:Bind PresetColors, Mode=OneWay}"
              SelectionMode="None" />
          <TextBlock x:Uid="ColorRecentTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="{x:Bind HasRecentColors, Mode=OneWay}" />
          <GridView
              IsItemClickEnabled="True"
              ItemClick="OnSwatchClick"
              ItemTemplate="{StaticResource ColorSwatchTemplate}"
              ItemsSource="{x:Bind RecentColors, Mode=OneWay}"
              SelectionMode="None"
              Visibility="{x:Bind HasRecentColors, Mode=OneWay}" />
          <ColorPicker
              x:Name="Picker"
              ColorSpectrumShape="Ring"
              IsAlphaEnabled="False"
              IsColorChannelTextInputVisible="False"
              IsHexInputVisible="True"
              IsMoreButtonVisible="False"
              ColorChanged="OnPickerColorChanged" />
        </StackPanel>
      </Flyout>
    </DropDownButton.Flyout>
  </DropDownButton>
</UserControl>
