<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IconPicker.App.Controls.LibraryListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:IconPicker.App.ViewModels">
  <Grid>
    <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" IsTabStop="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="viewModels:LibraryItemViewModel">
          <Grid Padding="0,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE8B7;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind FolderPath}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Uid="LibraryMissing" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsMissing}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button x:Uid="RescanLibraryButton" Click="OnRescanClick" Visibility="{x:Bind CanRescan}" />
              <Button x:Uid="RemoveLibraryButton" Click="OnRemoveClick" Visibility="{x:Bind CanRemove}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Uid="NoLibraries" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasNoLibraries, Mode=OneWay}" />
  </Grid>
</UserControl>
