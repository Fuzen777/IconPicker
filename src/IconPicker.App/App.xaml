<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="IconPicker.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <controls:TileTemplates xmlns:controls="using:IconPicker.App.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- The square card a large icon preview sits in. -->
      <Style x:Key="IconPreviewCardStyle" TargetType="Border">
        <Setter Property="Width" Value="148" />
        <Setter Property="Height" Value="148" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
