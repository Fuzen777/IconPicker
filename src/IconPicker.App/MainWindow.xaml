<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IconPicker.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <!-- Folders dropped anywhere in the window are opened. -->
  <Grid x:Name="RootGrid" AllowDrop="True" Background="Transparent" DragOver="OnDragOver" Drop="OnDrop">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar
        x:Name="AppTitleBar"
        x:Uid="AppTitleBar"
        IsBackButtonVisible="True"
        IsBackButtonEnabled="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
        IsPaneToggleButtonVisible="True"
        BackRequested="OnBackRequested"
        PaneToggleRequested="OnPaneToggleRequested">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
      </TitleBar.IconSource>
    </TitleBar>

    <NavigationView
        x:Name="Navigation"
        Grid.Row="1"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        PaneDisplayMode="LeftCompact"
        IsSettingsVisible="True"
        ItemInvoked="OnNavigationItemInvoked">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="HomeItem" x:Uid="NavigationHome">
          <NavigationViewItem.Icon>
            <SymbolIcon Symbol="Home" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="MyIconsItem" x:Uid="NavigationMyIcons">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE790;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <!-- The folder opened last, named after it once there is one; it comes back as it was left. -->
        <NavigationViewItem x:Name="FolderItem" Visibility="Collapsed">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8B7;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <Frame x:Name="ContentFrame" Navigated="OnFrameNavigated" />
    </NavigationView>
  </Grid>
</Window>
