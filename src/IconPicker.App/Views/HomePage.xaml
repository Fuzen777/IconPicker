<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IconPicker.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IconPicker.App.Controls">
  <ScrollViewer>
    <StackPanel MaxWidth="760" Padding="32,24,32,32" Spacing="20">
      <TextBlock x:Uid="HomeTitle" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock x:Uid="HomeIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

      <Grid Height="200">
        <Rectangle
            RadiusX="8"
            RadiusY="8"
            Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
            StrokeThickness="1.5"
            StrokeDashArray="4,3" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <FontIcon Glyph="&#xE838;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
          <TextBlock x:Uid="HomeDropText" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <Button x:Uid="HomeChooseFolderButton" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="OnChooseFolderClick" />
        </StackPanel>
      </Grid>

      <!-- Libraries: folders rescanned often. -->
      <Grid Margin="0,12,0,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Uid="HomeLibrariesTitle" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
        <Button x:Uid="RescanAllButton" Grid.Column="1" Command="{x:Bind Libraries.RescanAllCommand}" />
      </Grid>
      <controls:LibraryListControl ViewModel="{x:Bind Libraries}" />
    </StackPanel>
  </ScrollViewer>
</Page>
