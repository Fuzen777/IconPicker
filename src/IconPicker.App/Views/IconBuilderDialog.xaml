<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="IconPicker.App.Views.IconBuilderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IconPicker.App.Controls"
    x:Uid="IconBuilderDialog"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
  <ContentDialog.Resources>
    <!-- The builder needs room: the default dialog is far narrower. -->
    <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
  </ContentDialog.Resources>

  <!-- Sized to the window when it opens (see FitToWindow). -->
  <!-- Files can be dropped or pasted here as anywhere in the window: on the list they open the builder, on the builder they become its glyph. -->
  <Grid x:Name="ContentGrid" Width="940" Height="580" AllowDrop="True" Background="Transparent" DragOver="OnDragOver" Drop="OnDrop" KeyDown="OnContentKeyDown">
    <!-- First step from Icons: the saved icons, then the built-in ones. -->
    <controls:IconListControl ViewModel="{x:Bind List}" Visibility="{x:Bind IsListShown}" />

    <Grid RowSpacing="12" Visibility="{x:Bind IsBuilderShown}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <controls:IconBuilderControl ViewModel="{x:Bind Builder}" />
      <CheckBox Grid.Row="1" Content="{x:Bind Builder.SaveToMyIconsText, Mode=OneWay}" IsChecked="{x:Bind Builder.IsSaveToMyIconsChecked, Mode=TwoWay}" />
    </Grid>
  </Grid>
</ContentDialog>
