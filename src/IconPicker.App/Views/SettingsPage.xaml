<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IconPicker.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IconPicker.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
  <ScrollViewer>
    <StackPanel MaxWidth="900" Padding="32,24,32,32" Spacing="4">
      <TextBlock x:Uid="SettingsTitle" Margin="0,0,0,16" Style="{StaticResource TitleTextBlockStyle}" />

      <toolkit:SettingsCard x:Uid="IconTargetCard">
        <toolkit:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE71B;" />
        </toolkit:SettingsCard.HeaderIcon>
        <ComboBox MinWidth="220" SelectedIndex="{x:Bind ViewModel.IconTargetIndex, Mode=TwoWay}">
          <ComboBoxItem x:Uid="IconTargetCopy" />
          <ComboBoxItem x:Uid="IconTargetLink" />
        </ComboBox>
      </toolkit:SettingsCard>

      <toolkit:SettingsCard x:Uid="ContextMenuCard" Description="{x:Bind ViewModel.ContextMenuDescription, Mode=OneWay}">
        <toolkit:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE8A7;" />
        </toolkit:SettingsCard.HeaderIcon>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Uid="PointContextMenuHereButton" Command="{x:Bind ViewModel.PointContextMenuHereCommand}" Visibility="{x:Bind ViewModel.IsContextMenuElsewhere, Mode=OneWay}" />
          <ToggleSwitch x:Uid="ContextMenuToggle" MinWidth="0" IsOn="{x:Bind ViewModel.IsContextMenuOn, Mode=TwoWay}" />
        </StackPanel>
      </toolkit:SettingsCard>

      <toolkit:SettingsCard x:Uid="DataLocationCard" Description="{x:Bind ViewModel.DataLocationDescription}">
        <toolkit:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE88E;" />
        </toolkit:SettingsCard.HeaderIcon>
        <ToggleSwitch x:Uid="DataLocationToggle" MinWidth="0" IsEnabled="{x:Bind ViewModel.CanChangeDataLocation}" IsOn="{x:Bind ViewModel.IsPortable, Mode=TwoWay}" />
      </toolkit:SettingsCard>

      <toolkit:SettingsExpander x:Uid="LibrariesExpander" IsExpanded="True">
        <toolkit:SettingsExpander.HeaderIcon>
          <FontIcon Glyph="&#xE8F1;" />
        </toolkit:SettingsExpander.HeaderIcon>
        <Button x:Uid="AddLibraryButton" Command="{x:Bind ViewModel.Libraries.AddCommand}" />
        <toolkit:SettingsExpander.Items>
          <toolkit:SettingsCard ContentAlignment="Left">
            <controls:LibraryListControl ViewModel="{x:Bind ViewModel.Libraries}" />
          </toolkit:SettingsCard>
        </toolkit:SettingsExpander.Items>
      </toolkit:SettingsExpander>

      <toolkit:SettingsCard x:Uid="RestartExplorerCard">
        <toolkit:SettingsCard.HeaderIcon>
          <FontIcon Glyph="&#xE72C;" />
        </toolkit:SettingsCard.HeaderIcon>
        <Button x:Uid="RestartExplorerButton" Command="{x:Bind ViewModel.RestartExplorerCommand}" />
      </toolkit:SettingsCard>

      <toolkit:SettingsCard x:Uid="AboutCard" Description="{x:Bind ViewModel.VersionText}">
        <toolkit:SettingsCard.HeaderIcon>
          <ImageIcon Source="ms-appx:///Assets/AppIcon.ico" />
        </toolkit:SettingsCard.HeaderIcon>
      </toolkit:SettingsCard>
    </StackPanel>
  </ScrollViewer>
</Page>
