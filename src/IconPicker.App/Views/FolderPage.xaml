<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IconPicker.App.Views.FolderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="24,12,24,24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: the folder and what can be done with it. -->
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}" />
        <!-- A folder opened through a shortcut: the shortcut shows the icon too. -->
        <TextBlock
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.ShortcutText}"
            TextTrimming="CharacterEllipsis"
            Visibility="{x:Bind ViewModel.HasShortcut}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsSingleRoot, Mode=OneWay}">
        <ToggleButton x:Name="LibraryToggle" x:Uid="LibraryToggle" IsChecked="{x:Bind ViewModel.IsLibrary, Mode=TwoWay}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE8F1;" FontSize="14" />
            <TextBlock x:Uid="LibraryToggleText" />
          </StackPanel>
        </ToggleButton>
        <Button x:Uid="ChangeFolderButton" Command="{x:Bind ViewModel.ChangeFolderCommand, Mode=OneWay}" />
      </StackPanel>
    </Grid>

    <!-- Mode switch, always visible so a wrong guess is one click away. -->
    <Grid Grid.Row="1" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <SelectorBar x:Name="ModeSelector" SelectionChanged="OnModeSelectionChanged" Visibility="{x:Bind ViewModel.IsSingleRoot, Mode=OneWay}">
        <SelectorBarItem x:Name="SingleModeItem" x:Uid="ModeThisFolder" IsEnabled="{x:Bind ViewModel.CanUseSingleMode, Mode=OneWay}" />
        <SelectorBarItem x:Name="BatchModeItem" x:Uid="ModeEachSubfolder" />
      </SelectorBar>
      <ToggleSwitch
          x:Name="DeepToggle"
          x:Uid="DeepToggle"
          Grid.Column="2"
          MinWidth="0"
          IsOn="{x:Bind ViewModel.IsDeep, Mode=TwoWay}"
          Visibility="{x:Bind ViewModel.IsBatchMode, Mode=OneWay}" />
    </Grid>

    <Grid Grid.Row="2">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.IsDetecting, Mode=OneWay}">
        <ProgressRing IsActive="True" />
        <TextBlock x:Uid="DetectingFolder" />
      </StackPanel>
      <ContentControl x:Name="ModeContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
    </Grid>
  </Grid>
</Page>
